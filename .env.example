# =============================================================================
# FFT Environment Configuration
# =============================================================================
# Copy this file to .env.local (for local development) or set in deployment platform
# NEVER commit actual secrets to Git
# =============================================================================

# -----------------------------------------------------------------------------
# SUPABASE (Required for all environments)
# -----------------------------------------------------------------------------
# Local development (from `supabase start` output)
# Web app (Next.js) reads the NEXT_PUBLIC_* names:
NEXT_PUBLIC_SUPABASE_URL=http://localhost:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-local-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-local-service-role-key
# Mobile app (Flutter) reads these via --dart-define:
SUPABASE_URL=http://localhost:54321
SUPABASE_ANON_KEY=your-local-anon-key

# Production (set in Vercel/GitHub Secrets/Supabase Dashboard)
# NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
# NEXT_PUBLIC_SUPABASE_ANON_KEY=your-production-anon-key
# SUPABASE_SERVICE_ROLE_KEY=your-production-service-role-key

# -----------------------------------------------------------------------------
# SUPABASE REGION
# -----------------------------------------------------------------------------
# Primary region for production project
SUPABASE_REGION=ap-south-1

# -----------------------------------------------------------------------------
# FIREBASE CLOUD MESSAGING (Push Notifications - Phase 7)
# -----------------------------------------------------------------------------
# FIREBASE_PROJECT_ID=your-firebase-project
# FIREBASE_SERVER_KEY=your-fcm-server-key
# FIREBASE_WEB_API_KEY=your-web-api-key
# FIREBASE_APP_ID=your-app-id

# -----------------------------------------------------------------------------
# SMTP (Transactional Emails - Auth, Account Deletion, Notifications)
# -----------------------------------------------------------------------------
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=your-smtp-user
# SMTP_PASS=your-smtp-password
# SMTP_FROM=noreply@fft.app
# SMTP_FROM_NAME=FFT Tournament Platform

# -----------------------------------------------------------------------------
# MONITORING & ERROR TRACKING
# -----------------------------------------------------------------------------
# SENTRY_DSN=https://xxx@sentry.io/xxx
# SENTRY_ORG=your-org
# SENTRY_PROJECT=fft

# -----------------------------------------------------------------------------
# APPLICATION CONFIGURATION
# -----------------------------------------------------------------------------
# Web app URL (production)
NEXT_PUBLIC_APP_URL=https://fft.app

# Mobile app configuration (via --dart-define at build time)
# SUPABASE_URL=http://10.0.2.2:54321  (Android emulator)
# SUPABASE_ANON_KEY=your-local-anon-key

# -----------------------------------------------------------------------------
# FEATURE FLAGS
# -----------------------------------------------------------------------------
# Minimum player age (18+ for pilot, configurable)
FFT_MIN_AGE=18

# Enable push notifications (Phase 7)
FFT_ENABLE_PUSH=false

# Enable substitute players (deferred)
FFT_ENABLE_SUBSTITUTES=false

# Enable check-in flow (deferred)
FFT_ENABLE_CHECK_IN=false

# Default squad size (Free Fire India = 4)
FFT_DEFAULT_SQUAD_SIZE=4

# Dispute window hours (default)
FFT_DISPUTE_WINDOW_HOURS=2

# -----------------------------------------------------------------------------
# LEGAL & COMPLIANCE
# -----------------------------------------------------------------------------
# Privacy policy version (increment on changes)
FFT_PRIVACY_POLICY_VERSION=1.0

# Terms of service version
FFT_TOS_VERSION=1.0

# Grievance officer contact (DPDP requirement)
FFT_GRIEVANCE_EMAIL=grievance@fft.app
FFT_GRIEVANCE_PHONE=+91-xxxxxxxxxx

# Support contact
FFT_SUPPORT_EMAIL=support@fft.app

# -----------------------------------------------------------------------------
# DEVELOPMENT OVERRIDES (Local only)
# -----------------------------------------------------------------------------
# Enable debug logging
# DEBUG=supabase:*

# Mock external services (for CI/testing)
# MOCK_FCM=true
# MOCK_SMTP=true