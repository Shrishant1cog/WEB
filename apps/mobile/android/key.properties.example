# Release signing configuration
# Copy this file to android/key.properties and fill in your values
# NEVER commit this file with real credentials
# NEVER commit the keystore file (release.keystore)

# For LOCAL development with production signing:
# 1. Generate a keystore: keytool -genkey -v -keystore android/app/keystore/release.keystore -alias release -keyalg RSA -keysize 2048 -validity 10000
# 2. Copy this file to android/key.properties
# 3. Fill in the values below

# For CI/CD (GitHub Actions):
# Add these as encrypted repository secrets:
# - KEYSTORE_BASE64: base64-encoded release.keystore file (base64 -w0 release.keystore)
# - KEYSTORE_PASSWORD: keystore password
# - KEY_ALIAS: key alias (e.g., "release")
# - KEY_PASSWORD: key password

# The CI workflow will create key.properties and decode the keystore at build time.

storeFile=../android/app/keystore/release.keystore
storePassword=YOUR_STORE_PASSWORD
keyAlias=release
keyPassword=YOUR_KEY_PASSWORD