# =============================================================================
# FFT Web Application Environment Configuration
# =============================================================================
# Copy this file to .env.local for local development
# Set these values in Vercel/Production environment
# NEVER commit actual secrets to Git
# =============================================================================

# -----------------------------------------------------------------------------
# SUPABASE (Required)
# -----------------------------------------------------------------------------
# Local development (from `supabase start` output)
NEXT_PUBLIC_SUPABASE_URL=http://localhost:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-local-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-local-service-role-key

# Production (set in Vercel Dashboard)
# NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
# NEXT_PUBLIC_SUPABASE_ANON_KEY=your-production-anon-key
# SUPABASE_SERVICE_ROLE_KEY=your-production-service-role-key

# -----------------------------------------------------------------------------
# APPLICATION
# -----------------------------------------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000
# NEXT_PUBLIC_APP_URL=https://fft.app

# -----------------------------------------------------------------------------
# FIREBASE CLOUD MESSAGING (Phase 7)
# -----------------------------------------------------------------------------
# NEXT_PUBLIC_FIREBASE_API_KEY=your-api-key
# NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
# NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-project-id
# NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your-project.appspot.com
# NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your-sender-id
# NEXT_PUBLIC_FIREBASE_APP_ID=your-app-id
# FIREBASE_SERVER_KEY=your-fcm-server-key

# -----------------------------------------------------------------------------
# SMTP (Transactional Emails)
# -----------------------------------------------------------------------------
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=your-smtp-user
# SMTP_PASS=your-smtp-password
# SMTP_FROM=noreply@fft.app
# SMTP_FROM_NAME=FFT Tournament Platform

# -----------------------------------------------------------------------------
# MONITORING
# -----------------------------------------------------------------------------
# SENTRY_DSN=https://xxx@sentry.io/xxx
# NEXT_PUBLIC_SENTRY_DSN=https://xxx@sentry.io/xxx

# -----------------------------------------------------------------------------
# FEATURE FLAGS
# -----------------------------------------------------------------------------
NEXT_PUBLIC_MIN_AGE=18
NEXT_PUBLIC_ENABLE_PUSH=false
NEXT_PUBLIC_ENABLE_SUBSTITUTES=false
NEXT_PUBLIC_DEFAULT_SQUAD_SIZE=4
NEXT_PUBLIC_DISPUTE_WINDOW_HOURS=2

# -----------------------------------------------------------------------------
# LEGAL & COMPLIANCE
# -----------------------------------------------------------------------------
NEXT_PUBLIC_PRIVACY_POLICY_VERSION=1.0
NEXT_PUBLIC_TOS_VERSION=1.0
NEXT_PUBLIC_GRIEVANCE_EMAIL=grievance@fft.app
NEXT_PUBLIC_SUPPORT_EMAIL=support@fft.app